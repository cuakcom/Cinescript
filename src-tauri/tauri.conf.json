{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Cinescript",
        "width": 1400,
        "minHeight": 600,
        "minWidth": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "package": {
    "productName": "Cinescript",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "readTextFile": true,
        "writeTextFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "copyFile": true,
        "exists": true,
        "readDir": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "window": {
        "all": true,
        "minimize": true,
        "maximize": true,
        "toggleMaximize": true,
        "unMaximize": true,
        "unMinimize": true,
        "show": true,
        "hide": true,
        "close": true,
        "setFullscreen": true,
        "isFullscreen": true,
        "setResizable": true,
        "isResizable": true,
        "setMinSize": true,
        "setMaxSize": true,
        "setAlwaysOnTop": true,
        "isAlwaysOnTop": true,
        "setTitle": true,
        "setSkipTaskbar": true
      },
      "shell": {
        "all": true,
        "execute": true,
        "open": true,
        "sidecar": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "com.cinescript.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "signingIdentity": null,
        "timestampUrl": ""
      }
    }
  }
}
